[Unit]
Description=OpenAI Secure MCP Tunnel for GoreeCloud Remote MCP
After=network-online.target goreecloud-remote-mcp-broker.service
Wants=network-online.target goreecloud-remote-mcp-broker.service

[Service]
Type=simple
EnvironmentFile=%h/.config/goreecloud-remote-mcp/tunnel.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/tunnel-client run --profile goreecloud-remote-mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h
ReadWritePaths=%h/.config/tunnel-client %h/.config/goreecloud-remote-mcp
LockPersonality=yes

[Install]
WantedBy=default.target
