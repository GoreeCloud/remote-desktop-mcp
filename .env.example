# Broker
BROKER_HOST=127.0.0.1
BROKER_PORT=8788
# token = require a static bearer token (useful for non-ChatGPT clients that can set headers)
# none = allowed only on loopback; recommended behind OpenAI Secure MCP Tunnel
MCP_AUTH_MODE=token
MCP_BEARER_TOKEN=replace-with-long-random-token
BROKER_DEVICE_TOKEN=replace-with-separate-long-random-token
RPC_TIMEOUT_MS=30000

# Optional dashboard. Leave blank to disable.
ADMIN_USER=
ADMIN_PASSWORD=

# Agent
BROKER_WS_URL=ws://127.0.0.1:8788/agent
DEVICE_ID=personal-laptop
AGENT_DEVICE_TOKEN=replace-with-separate-long-random-token
AGENT_ALLOWED_ROOTS=/home/username
AGENT_ALLOW_WRITE=false
AGENT_ALLOW_SHELL=false
AGENT_MAX_READ_BYTES=1048576
AGENT_MAX_WRITE_BYTES=1048576
AGENT_MAX_COMMAND_OUTPUT_BYTES=1048576
AGENT_COMMAND_TIMEOUT_MS=30000
